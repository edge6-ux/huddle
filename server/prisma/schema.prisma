generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Better Auth models (do not modify field names) ──────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions         Session[]
  accounts         Account[]
  workspaceMembers WorkspaceMember[]
  teamMembers      TeamMember[]
  participants     Participant[]
  sentMessages     Message[]         @relation("MessageSender")
  sentDMs          DirectMessage[]   @relation("DMSender")
  receivedDMs      DirectMessage[]   @relation("DMReceiver")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Workspace / Team ────────────────────────────────────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())

  members WorkspaceMember[]
  teams   Team[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Team {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime @default(now())

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  rooms       Room[]
  inviteLinks TeamInviteLink[]
  messages    Message[]
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model TeamInviteLink {
  id        String    @id @default(cuid())
  teamId    String
  token     String    @unique
  createdBy String
  expiresAt DateTime?
  maxUses   Int?
  useCount  Int       @default(0)
  createdAt DateTime  @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

// ─── Rooms / Meetings ────────────────────────────────────────────────────────

model Room {
  id           String   @id @default(cuid())
  teamId       String?
  ownerId      String?
  slug         String   @unique
  name         String
  passwordHash String?
  createdAt    DateTime @default(now())

  team     Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  meetings Meeting[]
}

model Meeting {
  id        String    @id @default(cuid())
  roomId    String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  room         Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participants Participant[]
}

model Participant {
  id        String    @id @default(cuid())
  meetingId String
  userId    String?
  guestName String?
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ─── Messaging ───────────────────────────────────────────────────────────────

model Message {
  id        String   @id @default(cuid())
  teamId    String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sender User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
}

model DirectMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime @default(now())

  sender   User @relation("DMSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("DMReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}
